{
  "mcpServers": {
    "playwright_browser": {
      "command": "node",
      "args": ["${PLUGIN_ROOT}/server.mjs"],
      "enabled": true,
      "startup_timeout_sec": 120,
      "tool_timeout_sec": 3600,
      "env_vars": ["PLAYWRIGHT_MCP_EXTENSION_TOKEN", "PLAYWRIGHT_MCP_PROFILE_DIR_NAME"]
    }
  }
}
